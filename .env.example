# Yarnna Environment Configuration Template
# Strictly zero secrets committed to version control

NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# JWT Authentication Secret (Use minimum 32 random characters in production)
JWT_SECRET=yarnna_super_secret_jwt_key_testnet_2026_dev_only
JWT_EXPIRES_IN=7d

# Database Configuration (Defaults to embedded local database engine for development)
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Storage and Upload Configuration
MAX_PHOTO_SIZE_BYTES=2621440
MAX_VOICE_SIZE_BYTES=2097152
MAX_VOICE_DURATION_SECONDS=120
UPLOAD_DIR=./uploads

# Quota and Rate Limiting
MAX_POSTS_PER_MINUTE_PER_USER=4
MAX_MESSAGES_PER_MINUTE_PER_USER=30
GLOBAL_RATE_LIMIT_PER_MINUTE=120

# Optional AI Translation API (HuggingFace, Local Edge, or Azure)
# If blank, Yarnna uses its embedded local Nigerian phrasebook dictionary engine
AI_TRANSLATION_API_KEY=
AI_TRANSLATION_ENDPOINT=

# Admin Master MFA Bypass Key (For initial testnet bootstrapping only)
ADMIN_BOOTSTRAP_KEY=YarnnaAdminBootstrap2026!
